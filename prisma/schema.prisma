generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campaign {
  id              String         @id @default(cuid())
  name            String
  targetNiche     String
  targetLocation  String
  status          String         @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED
  totalLeadsFound Int            @default(0)
  totalAudited    Int            @default(0)
  totalSent       Int            @default(0)
  totalDelivered  Int            @default(0)
  totalRead       Int            @default(0)
  totalReplied    Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  leads           Lead[]
  dispatchLogs    DispatchLog[]
}

model Lead {
  id                String         @id @default(cuid())
  campaignId        String?
  campaign          Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  placeId           String?        @unique
  businessName      String
  category          String?
  address           String?
  city              String?
  state             String?
  country           String?        @default("IN")
  phoneNumber       String?
  formattedPhone    String?        @unique
  websiteUrl        String?
  email             String?
  googleRating      Float?
  reviewCount       Int?           @default(0)
  googleMapsUrl     String?
  
  // Digital Footprint & Audit
  hasWebsite        Boolean        @default(false)
  websiteWorking    Boolean        @default(false)
  isMobileFriendly  Boolean        @default(false)
  pageSpeedScore    Int?
  sslValid          Boolean        @default(false)
  pitchCategory     String?        // "WEB_APP_DEV", "ERP_CRM", "LOCAL_SEO_MARKETING"
  auditSummary      String?
  
  // Template & Pitch Copy
  assignedTemplate  String?        // "universal_b2b_web_v2", "universal_b2b_crm_intro", "universal_b2b_seo_intro"
  templateParameters String?      // JSON array of variables sent
  personalizedPitch String?
  pitchAngle        String?
  
  // Outreach & Dispatch Status
  isTemplateSent    Boolean        @default(false)
  status            String         @default("DISCOVERED") // DISCOVERED, AUDITED, QUEUED, SENT, DELIVERED, READ, REPLIED, CONVERTED
  lastMessageSentAt DateTime?
  lastError         String?
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  dispatchLogs      DispatchLog[]
}

model DispatchLog {
  id              String         @id @default(cuid())
  leadId          String
  lead            Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  provider        String         @default("CRM_API_KEY") // "CRM_API_KEY" or "META_CLOUD_API"
  messageType     String         @default("TEMPLATE") // TEMPLATE, TEXT
  templateName    String?
  messageBody     String
  status          String         // QUEUED, SENT, DELIVERED, READ, FAILED
  whatsappMsgId   String?
  errorMessage    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model AppSettings {
  id                    String   @id @default("global_settings")
  globalAutoDispatch    Boolean  @default(false)
  globalScrapeLimit     Int      @default(20)
  crmApiUrl             String   @default("https://crmapi.jisnudigital.com/api/v1/whatsapp/send-template")
  crmApiKey             String?
  updatedAt             DateTime @updatedAt
}

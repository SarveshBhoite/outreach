# Database URL (Neon Postgres)
DATABASE_URL="postgresql://username:password@host/neondb?sslmode=require"

# Google Cloud APIs
GOOGLE_PLACES_API_KEY="your_google_places_api_key"
GOOGLE_PAGESPEED_API_KEY="your_google_pagespeed_api_key"
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_whatsapp_waba_id"
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_WHATSAPP_CONFIG_ID="your_meta_whatsapp_config_id"
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_token"
WHATSAPP_DEFAULT_TEMPLATE="hello_world"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="my_secure_verify_token_123"

# AI Engine
GEMINI_API_KEY="your_gemini_api_key"
